{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickAppDesktop",
  "version": "0.1.0",
  "identifier": "com.chendd.quickapp.desktop",
  "build": {
    "beforeDevCommand": "node scripts/serve.mjs 1420",
    "devUrl": "http://localhost:1420/?es_pkg=cn.chenddcoder.tvcast",
    "beforeBuildCommand": "",
    "frontendDist": "../../quicktvui/packages/web-runtime/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns"
    ]
  }
}
