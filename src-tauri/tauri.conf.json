{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "投屏显象",
  "version": "0.1.2",
  "identifier": "com.chendd.toupingxianxiang",
  "build": {
    "beforeDevCommand": "node scripts/serve.mjs 1420",
    "devUrl": "http://localhost:1420/",
    "beforeBuildCommand": "",
    "frontendDist": "../../quicktvui/packages/web-runtime/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
